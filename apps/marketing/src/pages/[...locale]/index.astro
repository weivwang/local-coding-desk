---
import { Image } from "astro:assets";
import appIcon from "../../assets/icon.webp";
import Layout from "../../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL } from "../../lib/site";
import { localeStaticPaths } from "../../i18n/locales";

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props;
---

<Layout title="Local Coding Desk" description="A local desktop app for coding agents." {locale} localizedPath="/" noindex>
  <section class="desk-intro">
    <Image src={appIcon} width={92} height={92} alt="" />
    <h1>Local Coding Desk</h1>
    <p>Run coding agents on your Mac with authenticated local access.</p>
    <a href={`${GITHUB_REPOSITORY_URL}/releases/latest`}>Download for Apple Silicon</a>
    <p class="desk-credit">An unofficial fork of <a href="https://github.com/pingdotgg/t3code">T3 Code</a>.</p>
  </section>
</Layout>

<style>
  .desk-intro { display: grid; gap: 1rem; justify-items: center; padding: 5rem 1rem; text-align: center; }
  .desk-intro h1 { margin: 0; font-size: clamp(2rem, 6vw, 4rem); }
  .desk-credit { font-size: 0.875rem; }
</style>
